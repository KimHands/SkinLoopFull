# BE 환경변수 예시. 실제 값은 .env에 넣고 커밋하지 않는다.

# DB. 로컬 개발은 SQLite 기본(미설정 시 sqlite:///./skinloop.db).
# 배포는 Postgres(가비아/Supabase)로 아래 형식 사용.
# DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/postgres

# CORS 허용 오리진(콤마 구분). 배포 시 FE 도메인만 허용. 기본 * (개발용).
CORS_ORIGINS=*

# LLM 문장화(patterns/whatif narrative)에 필요. 없으면 문장화 호출 시 오류.
OPENAI_API_KEY=
