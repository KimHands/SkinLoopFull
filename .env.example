# docker-compose 통합 스택 환경변수. 복사해서 .env로 쓴다: cp .env.example .env
# (.env 는 커밋하지 않는다.)

# PostgreSQL 비밀번호(db/be 공유).
POSTGRES_PASSWORD=skinloop

# 리버스 프록시(Caddy) 사이트 주소.
#  로컬:  :80                       (평문 http, http://localhost)
#  배포:  1-201-117-248.nip.io      (도메인 지정 시 Caddy 자동 HTTPS)
SITE_ADDRESS=:80
# Let's Encrypt 알림 이메일(선택).
ACME_EMAIL=admin@skinloop.app

# 백엔드 CORS 허용 오리진. 배포 시 접속 URL과 일치시킨다.
CORS_ORIGINS=*

# LLM 문장화용. 없으면 규칙 기반 폴백으로 동작(핵심 플로우는 정상).
OPENAI_API_KEY=

# 프론트엔드가 API를 부를 오리진(브라우저 기준, 빌드 시점 인라인).
#  로컬:  http://localhost
#  배포:  https://1-201-117-248.nip.io
NEXT_PUBLIC_API_BASE=http://localhost
